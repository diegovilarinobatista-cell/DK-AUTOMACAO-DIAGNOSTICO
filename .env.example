# Supabase (public values — already have safe defaults in src/lib/supabase.ts)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Real AI (server-side only, set in Vercel → Settings → Environment Variables).
# Without it the app runs in demo mode with the built-in rules engine.
ANTHROPIC_API_KEY=
# Optional: ANTHROPIC_MODEL=claude-sonnet-5-5
